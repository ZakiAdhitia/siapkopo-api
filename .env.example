APP_NAME=SIAPKOPO
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL already running on the user's machine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_kopo

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OTP_TTL_SECONDS=300
OTP_LENGTH=6

CORS_ORIGINS=http://localhost:5173

PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify
MAX_UPLOAD_SIZE_BYTES=5242880
UPLOAD_STORAGE_DIR=storage

# WhatsApp gateway for password-reset OTP delivery -- get a token from
# https://fonnte.com
FONNTE_API_KEY=
